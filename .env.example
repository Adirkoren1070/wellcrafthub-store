# Copy this file to .env for local testing with `netlify dev`.
# In production, set these same names as Environment Variables in the
# Netlify dashboard instead (Site configuration > Environment variables).
# Never commit a real .env file.

# Your Stripe secret key (starts with sk_test_... or sk_live_...)
# Find it at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_replace_me

# One Stripe Price ID per product (starts with price_...).
# Create each as a Product > Price in the Stripe Dashboard, then paste the
# Price ID here. See README.md for step-by-step instructions.
STRIPE_PRICE_WELLNESS_BUNDLE=price_replace_me
STRIPE_PRICE_LONGEVITY_PLANNER=price_replace_me
STRIPE_PRICE_THRIVE_WEEKLY_PLANNER=price_replace_me
STRIPE_PRICE_BLUEPRINT_WORKBOOK=price_replace_me
